{
  "name": "web3toolbox",
  "author": "Aming",
  "version": "1.2.0",
  "private": true,
  "main": "electron.js",
  "license": "MIT",
  "homepage": ".",
  "build": {
    "appId": "com.aming.web3toolbox",
    "productName": "web3toolbox",
    "extends": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "client/build/**/*",
      "node_modules/**/*",
      "client/public/**/*",
      "electron.js",
      "preload.js",
      "server/**/*",
      "resources/**/*",
      "package.json",
      "config.js",
      "!assets/savePath.json",
      "!assets/chromePath.json",
      "!assets/extensionInfo.json"
    ],
    "extraResources": [
      {
        "from": "./toolService",
        "to": "./toolService",
        "filter": ["**/*", "!**/*.test.*", "!**/coverage/**", "!**/.git/**"]
      },
      {
        "from": "./dbservice",
        "to": "./dbservice",
        "filter": ["**/*", "!**/*.test.*", "!**/coverage/**", "!**/.git/**"]
      },
      {
        "from": "./assets",
        "to": "./assets",
        "filter": [
          "**/*",
          "!savePath.json",
          "!chromePath.json",
          "!/scripts/extensionInfo.json",
          "!agents/*/data/**",
          "!agents/*/workspace/**",
          "!ip2location/**"
        ]
      }
    ],
    "beforeBuild": "./scripts/before-build.js",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "client/build/logo_512x512.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "client/build/logo.ico"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@azure/identity": "^4.13.0",
    "@azure/search-documents": "^12.2.0",
    "@flashbots/ethers-provider-bundle": "^1.0.0",
    "@google/genai": "^1.44.0",
    "@langchain/core": "^1.1.32",
    "@mistralai/mistralai": "^1.15.1",
    "@qdrant/js-client-rest": "^1.17.0",
    "@solana/web3.js": "^1.98.2",
    "@supabase/supabase-js": "^2.99.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@uniswap/v2-core": "^1.0.1",
    "@uniswap/v2-periphery": "^1.1.0-beta.0",
    "async-mutex": "^0.5.0",
    "axios": "^1.6.8",
    "better-sqlite3": "^12.6.2",
    "bip39": "^3.1.0",
    "bootstrap": "^5.3.3",
    "ccxt": "4.3.63",
    "cheerio": "^1.2.0",
    "cloudflare": "^5.2.0",
    "cors": "^2.8.5",
    "date-and-time": "^3.1.1",
    "docx": "^9.6.1",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.11.1",
    "events": "^3.3.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "express-ws": "^5.0.2",
    "geo-tz": "^8.0.2",
    "groq-sdk": "^1.1.1",
    "http": "^0.0.1-security",
    "http-proxy-agent": "^7.0.2",
    "i18next": "^25.2.1",
    "ip2location-nodejs": "^9.6.1",
    "mammoth": "^1.11.0",
    "mem0ai": "^2.3.0",
    "nedb": "^1.8.0",
    "neo4j-driver": "^6.0.1",
    "ollama": "^0.6.3",
    "path-browserify": "^1.0.1",
    "pg": "^8.20.0",
    "portscanner": "^2.2.0",
    "process": "^0.11.10",
    "proxy-chain": "^2.4.0",
    "qs": "^6.12.3",
    "react": "^18.2.0",
    "react-app-rewired": "^2.2.1",
    "react-bootstrap": "^2.10.1",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.5.3",
    "react-router-dom": "^6.22.1",
    "react-scripts": "^5.0.1",
    "redis": "^5.11.0",
    "sass": "^1.71.1",
    "sass-loader": "^14.1.1",
    "socket.io-client": "^4.7.4",
    "socks": "^2.8.1",
    "socks-proxy-agent": "^8.0.3",
    "sql.js": "^1.14.1",
    "url": "^0.11.3",
    "uuid": "^11.1.0",
    "web-vitals": "^2.1.0",
    "zustand": "^5.0.6"
  },
  "scripts": {
    "dev": "cross-env IS_BUILD=false electron .",
    "dist": "electron-builder",
    "start": "react-app-rewired start",
    "build": "react-app-rewired build --port 30001",
    "test": "react-app-rewired test",
    "test:client": "react-app-rewired test --watchAll=false --runInBand client/src/pages/taskManage/index.test.js client/src/utils/api.test.js client/src/utils/webSocket.test.js client/src/components/taskOffcanvas/index.test.js client/src/components/taskOffcanvas/AITaskPanel.test.js client/src/pages/agentWorkspace/index.test.js",
    "test:server": "jest server/services/webSocketService.test.js server/services/taskService.test.js --runInBand",
    "test:all": "npm run test:client && npm run test:server",
    "test:e2e": "playwright test -c test/playwright.config.js",
    "test:e2e:claude": "cross-env E2E_PROVIDER=claude-code playwright test -c test/playwright.config.js test/onboarding-e2e.spec.js --headed",
    "test:e2e:codex": "cross-env E2E_PROVIDER=codex-cli playwright test -c test/playwright.config.js test/onboarding-e2e.spec.js --headed",
    "test:e2e:ui": "playwright test -c test/playwright.config.js --ui",
    "test:toolbox": "node test/test-toolbox.js",
    "test:toolbox:quick": "node test/test-toolbox.js --skip-install --skip-browser",
    "eject": "react-scripts eject",
    "pack": "electron-builder --dir"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "crypto-browserify": "^3.12.0",
    "customize-cra": "^1.0.0",
    "dotenv": "^16.4.5",
    "electron": "29.0.1",
    "electron-builder": "^24.12.0",
    "electron-is-dev": "^3.0.1",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "wait-on": "^7.2.0",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "zlib-browserify": "^0.0.3"
  },
  "proxy": "http://localhost:30001"
}
